{
  "name": "adira-wa-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:local": "tsx src/dev-local.ts",
    "tunnel": "tsx src/tunnel.ts",
    "inspect": "tsx src/inspect.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "smoke": "tsx src/smoke.ts",
    "harness": "tsx src/harness.ts",
    "doctor": "tsx src/doctor.ts",
    "verify:endpoint": "tsx src/verify-endpoint.ts",
    "doctor:prod": "node dist/doctor.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "mongodb": "^6.12.0",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
