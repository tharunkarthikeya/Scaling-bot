{
  "name": "adira-wa-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:local": "tsx src/dev-local.ts",
    "tunnel": "tsx src/tunnel.ts",
    "inspect": "tsx src/inspect.ts",
    "reset": "tsx src/reset.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "smoke": "tsx src/smoke.ts",
    "harness": "tsx src/harness.ts",
    "test:ocr-async": "tsx src/ocr-async-test.ts",
    "bench:inspect": "node --expose-gc --import tsx src/bench-inspect.ts",
    "loadtest:mongo": "docker compose -f loadtest/docker-compose.yml up -d",
    "loadtest:mongo:down": "docker compose -f loadtest/docker-compose.yml down -v",
    "loadtest:mock": "tsx loadtest/mock-anthropic/server.ts",
    "loadtest:mock-ocr": "tsx loadtest/mock-veris/server.ts",
    "loadtest:rig": "node --max-old-space-size=4096 --import tsx loadtest/rig/index.ts",
    "loadtest": "tsx loadtest/generator/index.ts",
    "loadtest:check": "tsc -p loadtest/tsconfig.json --noEmit",
    "doctor": "tsx src/doctor.ts",
    "verify:endpoint": "tsx src/verify-endpoint.ts",
    "verify:crm": "tsx src/verify-crm.ts",
    "e2e:crm": "tsx src/e2e-crm.ts",
    "verify:taxonomy": "tsx src/verify-taxonomy.ts",
    "doctor:prod": "node dist/doctor.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "mongodb": "^6.12.0",
    "pino": "^9.6.0",
    "veriis": "^0.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
