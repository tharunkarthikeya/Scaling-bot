# =============================================================================
#  adira-wa-bot — environment
# =============================================================================
#
#  Copy to `.env` for local development. In production these are set in the
#  Dokploy Environment tab, not in a file — `.env` is gitignored and is not
#  copied into the image.
#
#  NO SECRET IN THIS FILE IS REAL. Every value below is either a default, a
#  placeholder, or a shape. Anything marked REQUIRED has no default and the
#  process refuses to start without it, naming the variable.
#
#  Variables are grouped as they are in `src/config.ts`, which carries the long
#  reasoning for each. This file carries the short version.
#
# =============================================================================


# --- Process -----------------------------------------------------------------

NODE_ENV=development
PORT=3100
LOG_LEVEL=info

# What this container does. One image, four possible jobs.
#
#   all        HTTP + workers + sweeps. The default, and what a single-instance
#              deployment should stay on. Correct at any replica count WITH
#              Redis; correct at exactly one instance without it.
#   web        Webhook and admin API only. Enqueues work, never performs it.
#   worker     BullMQ consumers only. No webhook.
#   scheduler  Sweeps only, behind a Redis lease so N replicas sweep once.
#
# Anything but `all` REQUIRES REDIS_URL and STORAGE_DRIVER=s3. The process
# refuses to start otherwise, because a role whose partner cannot see its queue
# or its files is not a smaller version of this architecture — it is two bots.
ROLE=all

# Names this replica in logs, metrics and lock tokens.
# Defaults to hostname:pid, which under Docker is the container id. Leave unset.
# INSTANCE_ID=


# --- MongoDB (REQUIRED) ------------------------------------------------------
#
# On Dokploy use the Internal Connection URL of the Mongo service, not
# localhost. The app and the database must be in the same project for the
# internal hostname to resolve.

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=adira

# The ATS database a finished conversation is copied into. A second database on
# the same deployment, so it needs no connection string of its own. Every row
# the bot writes there carries source: 'whatsapp'. Blank it to turn the export
# off - which is what a local run with no ATS to write to wants.
RESUME_ATS_DB=resume_ats


# --- Redis -------------------------------------------------------------------
#
# What makes more than one instance safe. Three things depend on it and each is
# a correctness boundary rather than an optimisation:
#
#   the job queue      a turn is executed once, by one worker, and survives the
#                      restart of whichever process accepted it
#   candidate locks    two instances cannot answer the same candidate at once
#   rate limiters      N instances share Meta's 20/sec instead of spending
#                      20/sec each — Meta DROPS the overage, it does not queue it
#
# Omit it and all three fall back to per-process implementations that are
# correct for exactly one instance. That is fine for local development and
# unsafe behind a load balancer.
#
# On Dokploy: create a Redis service in the same project and use its Internal
# Connection URL. The hostname is the service's own name on the internal
# network and the port is 6379. Never expose it publicly — it holds candidate
# lock state and the job payloads.
#
#   REDIS_URL=redis://:PASSWORD@<redis-service-name>:6379
#
# REDIS_URL=

# Namespaces every key, so one Redis can serve staging and production without
# the two consuming each other's jobs.
REDIS_KEY_PREFIX=adira

# Candidate lock. TTL is a crash guard, not a timeout — the lock is renewed
# while its holder is alive, so long work keeps its lock. The TTL bounds how
# long a candidate stays locked by a process that died holding it.
LOCK_TTL_MS=30000

# How long to wait for a candidate's lock before giving up on the turn. Giving
# up fails the job, which BullMQ retries — the turn is deferred, not lost.
LOCK_ACQUIRE_TIMEOUT_MS=30000


# --- WhatsApp / Meta (REQUIRED) ----------------------------------------------

# Meta signs every webhook with this. Get it from the app's Basic Settings.
WHATSAPP_APP_SECRET=replace-me
# Any string you choose. Meta echoes it back during subscription.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-me
# A permanent System User token, not a temporary one from the dashboard.
WHATSAPP_ACCESS_TOKEN=replace-me
# The number that sends. Numeric id, not the phone number.
WHATSAPP_PHONE_NUMBER_ID=000000000000000

# Optional. The second number, which runs the Singapore/Malaysia flow: no CV up
# front, two destinations instead of five, and the CV asked after the job
# preferences and only where a CV says something about the job. See
# `src/conversation/lines.ts`.
#
# Numeric id again, and the one Meta reports as `phone_number_id` in the webhook
# — not the display number, which is a different value and matches nothing.
# Leave it unset and there is no second line: every message runs the flow this
# bot has always run.
# It must differ from WHATSAPP_PHONE_NUMBER_ID; the same id in both would route
# every candidate to the Singapore/Malaysia flow, and boot refuses it.
# WHATSAPP_PHONE_NUMBER_ID_SGMY=
# The WABA the second number belongs to. Only `doctor` reads it, to check the
# app is subscribed to that account as well as to the first.
# WHATSAPP_WABA_ID_SGMY=

# Only when the two numbers sit under two different Meta apps.
#
# Two WABAs under ONE app share an app secret and an access token, and both of
# these stay unset - which is the usual arrangement. Two WABAs under TWO apps do
# not share either, and leaving these blank would mean every webhook from the
# second number failing its signature check and every reply to it getting a 401.
# From outside, both look exactly like the bot ignoring that number.
# WHATSAPP_APP_SECRET_SGMY=
# WHATSAPP_ACCESS_TOKEN_SGMY=

# Optional. Only used by `doctor` to check the webhook subscription.
# WHATSAPP_WABA_ID=
WHATSAPP_GRAPH_API_VERSION=v25.0

# Approved template for re-engaging a candidate outside the 24-hour window.
# WHATSAPP_REENGAGEMENT_TEMPLATE=
WHATSAPP_REENGAGEMENT_TEMPLATE_LANG=en


# --- Anthropic (REQUIRED) ----------------------------------------------------

ANTHROPIC_API_KEY=sk-ant-replace-me
CLAUDE_MODEL=claude-opus-5

# Retries after the first attempt. The SDK does the backoff, honouring
# retry-after. Raising this does not buy much: if three attempts in a second
# and a half all come back throttled, the problem is the rate, not the count.
MODEL_MAX_RETRIES=2
MODEL_TIMEOUT_MS=30000

# Calls in flight at once, PER PROCESS. Bounds this process's fan-out and, more
# importantly, bounds the queue of calls waiting to be made.
MODEL_MAX_CONCURRENCY=8
# Calls allowed to queue for a slot before we start refusing. An unbounded
# queue turns a throttled minute into an out-of-memory hour.
MODEL_MAX_QUEUED=32

# Calls per second across the WHOLE FLEET. 0 disables it.
#
# The counterpart to MODEL_MAX_CONCURRENCY and a deliberately different kind of
# limit: concurrency is per process because it protects this process's memory;
# rate is fleet-wide because it protects an org quota that Anthropic enforces
# per minute and that four replicas would otherwise spend four times over.
#
# Off by default — the right number is an account fact, and a limiter set from
# a guess is a self-inflicted outage. Set it to the tier's RPM / 60, with
# headroom, once you know the tier.
MODEL_RATE_PER_SECOND=0


# --- Veris OCR (REQUIRED) ----------------------------------------------------

VERIS_OCR_BASE_URL=https://replace-me
VERIS_OCR_API_KEY=replace-me
VERIS_OCR_TIMEOUT_MS=120000

# Use the async Jobs API rather than the synchronous extract routes.
VERIS_OCR_ASYNC=false
VERIS_OCR_JOB_TIMEOUT_MS=900000
VERIS_OCR_POLL_MIN_MS=2000
VERIS_OCR_POLL_MAX_MS=15000
OCR_SWEEP_INTERVAL_MS=3000
OCR_CLAIM_STALE_MS=120000


# --- Storage -----------------------------------------------------------------
#
# Candidate documents. A passport arrives on one process and is read back later
# by another — an OCR worker, then the CRM sync. On one container those are the
# same filesystem. On three they are not.
#
#   local  a mounted volume. Correct for exactly one instance.
#   s3     any S3-compatible bucket. Required for more than one.
#
# MIGRATION: keys are identical across both drivers, but documents already on
# the volume are NOT in the bucket. Copy them first, then switch, or every
# existing document is stranded.

STORAGE_DRIVER=local

# Where `local` writes. Must be a mounted volume in production — a container
# filesystem does not survive a redeploy.
STORAGE_PATH=./storage

# Required when STORAGE_DRIVER=s3.
# S3_BUCKET=adira-documents
# S3_ACCESS_KEY_ID=replace-me
# S3_SECRET_ACCESS_KEY=replace-me

# `auto` is what Cloudflare R2 expects. Real AWS wants its own region.
S3_REGION=auto
# Set for R2, MinIO, Backblaze, Wasabi. Omit for real AWS S3.
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# Every self-hosted S3-compatible service needs path style; AWS accepts it.
S3_FORCE_PATH_STYLE=true
# Key prefix inside the bucket, so one bucket can hold more than one
# environment. Never reaches the database.
S3_PREFIX=


# --- Outbound rate limits ----------------------------------------------------
#
# These are Meta's limits for the number, not ours to raise: over-limit
# messages are DROPPED, not queued. With REDIS_URL set these are shared across
# every instance, which is the only way the numbers mean anything at replica
# count > 1.
#
# Three separate budgets on purpose. One shared bucket meant read receipts and
# media downloads spent capacity Meta grants for SENDING MESSAGES, so a
# candidate's reply queued behind the acknowledgement of their own last one.

OUTBOUND_RATE_PER_SECOND=20
READ_RECEIPT_RATE_PER_SECOND=20
MEDIA_DOWNLOAD_RATE_PER_SECOND=10

# Largest inbound file this bot will hold, in bytes. Ten megabytes. Meta's own
# ceiling is 100MB, and accepting that is a promise this box cannot keep.
MEDIA_MAX_BYTES=10485760


# --- Queue concurrency -------------------------------------------------------
#
# PER PROCESS, per job name. One pool each, so a saturated extraction queue
# cannot starve inbound conversation. With ROLE=worker, total fleet concurrency
# is this multiplied by the replica count — which is the point, and also the
# thing to remember before raising both at once.
#
# Almost all of this work is I/O, so these are not core counts. What bounds
# them is the slowest thing downstream, which today is the outbound limiter.

QUEUE_CONCURRENCY_INBOUND=8
QUEUE_CONCURRENCY_OCR=3
QUEUE_CONCURRENCY_CRM_SYNC=2


# --- Ingestion ---------------------------------------------------------------

INGESTION_MAX_ATTEMPTS=5
INGESTION_RECONCILE_INTERVAL_MS=300000
INGESTION_STALE_AFTER_MS=900000
INGESTION_QUEUE_AGE_ALERT_MS=1800000


# --- Recruitment CRM ---------------------------------------------------------
#
# Optional. Without it registrations still complete and are still stored here;
# their sync status stays pending rather than failing, so nothing is lost if
# the CRM is added later.

# CRM_API_URL=https://replace-me
# CRM_API_KEY=replace-me
CRM_TIMEOUT_MS=15000
CRM_SYNC_MAX_ATTEMPTS=6

# Whether a registration still being answered is sent to the CRM.
#
# On, a candidate appears in the CRM as soon as they have consented and told us
# something, and fills in as they answer — which is what a recruiter watching
# the desk wants, because someone who stops halfway is still someone worth
# ringing. Off, only finished registrations are sent.
#
# Consent is the floor either way: nothing is sent about anybody who has not
# given it, whichever way this is set.
CRM_PARTIAL_SYNC=true

# How long answers are collected before a snapshot goes out.
#
# Every answered question and every arrived document schedules one, and
# deliveries inside one window collapse into a single submission carrying all of
# them. So this is the CRM's worst-case lag behind the conversation, and nothing
# more — lower it for a livelier desk, raise it to spend fewer requests.
CRM_PARTIAL_SYNC_DEBOUNCE_MS=10000


# --- Admin API ---------------------------------------------------------------
#
# Guards /api/*, which expose candidate PII — names, passport numbers,
# transcripts. Unset means those routes are NOT SERVED AT ALL, which is the
# safe default for a public deployment. Minimum 16 characters.

# ADMIN_API_KEY=


# --- Metrics -----------------------------------------------------------------
#
# GET /metrics, Prometheus text format. No candidate PII: no waId, no name, no
# document, and routes are labelled by pattern rather than by url precisely so
# that stays true.

METRICS_ENABLED=true

# Requires X-API-Key on /metrics. Unset means the endpoint is open, which is
# right on a private network and wrong on a public domain — this bot is served
# at one, so set it there. Minimum 16 characters.
# METRICS_API_KEY=


# --- Modes -------------------------------------------------------------------

# true = process inbound and decide a reply, but never hand it to Meta.
SHADOW_MODE=false

# Test only. Serves a canned file instead of calling Meta's media API. Never
# set this in production.
MOCK_WHATSAPP_MEDIA=false
